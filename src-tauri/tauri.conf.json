{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Florin",
  "version": "0.4.0",
  "identifier": "com.devprojectekla.florin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Florin",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {},
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGMjNFODg1MjcyREJEMTAKUldRUXZTMG5oZWdqdjdNeEFsNUFZVzZ5ZDJLd3dONll4MHhtclJyV0VpOUxINDJ0QUt1RzFIQVUK",
      "endpoints": [
        "https://github.com/DevprojectEkla/florin/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  }
}
